# Gemini API key — get a free key at https://aistudio.google.com/apikey
# SERVER-SIDE ONLY (no VITE_ prefix): the API proxies Gemini so the key is never
# shipped to the browser. In production set this as a Vercel env var, not a build var.
GEMINI_API_KEY=AIza...

# Gemini model for AI Fill. Free-tier rate limits (RPM = requests per minute):
#   gemini-3.1-flash-lite   highest RPM — default; best for frequent use
#   gemini-2.0-flash-lite   30 RPM
#   gemini-2.0-flash        15 RPM  — stronger reasoning, useful for obscure trims
#   gemini-2.5-flash        10 RPM
#   gemini-2.5-pro           2 RPM  — hits quota immediately on free tier
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Superuser login ──────────────────────────────────────────────────────────
# Single-user gate over the whole API. Leave BLANK to disable auth (the default
# for local dev — the app stays open and offline). Set a password in production
# to require login. The gate protects /api/*, not just the UI.
#
#   AUTH_USERNAME       login name (default "admin")
#   AUTH_PASSWORD       plaintext password — simplest, OR
#   AUTH_PASSWORD_HASH  scrypt "salt:hash" from `node scripts/hash-password.mjs '...'`
#                       (preferred — keeps the plaintext password out of the env)
#   AUTH_SECRET         optional HMAC key for signing session cookies
#   AUTH_SESSION_DAYS   session lifetime in days (default 30)
#   AUTH_DISABLED=true  explicit production opt-out; without this, production
#                       fails closed if no password/hash is configured
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
AUTH_SECRET=
AUTH_DISABLED=

# Database (Turso / libSQL).
# Leave both BLANK for local development — the API falls back to a local SQLite
# file (garage.db) so the app runs fully offline with no account needed.
# For production (e.g. Vercel), create a Turso DB (https://turso.tech) and set:
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
